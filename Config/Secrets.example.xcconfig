// Bu şablon git'e girer, gerçek değerler girmez. `make generate` ilk çalıştığında bunu
// Config/Secrets.xcconfig olarak kopyalar.

// Gemini API anahtarı yalnızca geliştirici araçları için: `make gemini-live` ve scripts/check-gemini.sh.
// Uygulamaya gömülmez; uygulama anahtarı Ayarlar > Yapay zekâ'dan alır (aistudio.google.com > Get API key).
GEMINI_API_KEY = BURAYA_ANAHTARINI_YAZ

// Apple Developer takım kimliğin (developer.apple.com > Account > Membership details > Team ID).
// Cihaza kurmak ve iCloud senkronu için gerekli; simülatörde boş kalabilir.
DEVELOPMENT_TEAM =
