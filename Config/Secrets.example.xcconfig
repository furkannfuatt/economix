// Gemini API anahtarı — bu şablon git'e girer, gerçek anahtar girmez.
// `make generate` ilk çalıştığında bunu Config/Secrets.xcconfig olarak kopyalar.
// Anahtarı Config/Secrets.xcconfig içine yaz (aistudio.google.com > Get API key).
GEMINI_API_KEY = BURAYA_ANAHTARINI_YAZ

// Apple Developer takım kimliğin (developer.apple.com > Account > Membership details > Team ID).
